
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId);
      
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /agents/{agentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
    }

    match /messages/{messageId} {
      // Users can see messages sent to or from their agents.
      // For MVP, we simplify to: if the user is authenticated, they can see messages.
      // Real-world: Check if request.auth.uid owns either sender_id or recipient_id.
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }
  }
}
