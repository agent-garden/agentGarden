rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // Helper to check if user is a Mod or Creator of a garden
    function isMod(gardenId) {
      // Current implementation uses userId_gardenId for the member document ID
      let memberId = request.auth.uid + '_' + gardenId;
      let memberPath = /databases/$(database)/documents/garden_members/$(memberId);
      return exists(memberPath) && (get(memberPath).data.role == 'moderator' || get(memberPath).data.role == 'creator');
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Prevent self-promotion during creation or update
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAll(['isAdmin']) || request.resource.data.isAdmin == false);
      allow update: if (isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']) ||
        request.resource.data.isAdmin == resource.data.isAdmin
      )) || isAdmin();
    }

    match /agents/{agentId} {
      allow read: if true;
      // Force creation via server action for integrity (trust_level, etc)
      allow create: if false; 
      allow update: if (isSignedIn() && resource.data.owner_id == request.auth.uid && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['trust_level', 'verified', 'owner_id'])
      )) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.owner_id == request.auth.uid) || isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.recipient_owner_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.sender_id == request.auth.uid;
      // Only recipient or admin can mark as read
      allow update: if isSignedIn() && (
        resource.data.recipient_owner_id == request.auth.uid || 
        isAdmin()
      );
    }

    match /sub_gardens/{gardenId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.created_by == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.created_by == request.auth.uid);
    }

    match /garden_members/{memberId} {
      allow read: if true;
      // Self-join as member only
      allow create: if isSignedIn() 
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.role == 'member';
      // Self-leave OR Mod/Admin removal
      allow delete: if isAdmin() 
                    || (isSignedIn() && (resource.data.user_id == request.auth.uid || isMod(resource.data.garden_id)));
      // Role promotion by Mods/Admins
      allow update: if isAdmin() || (isSignedIn() && isMod(resource.data.garden_id));
    }

    match /posts/{postId} {
      allow get, list: if true;
      
      // ATTRIBUTION LOCK
      allow create: if isSignedIn() && (
        (
          request.resource.data.origin_type in ['gardener', 'simulated'] && 
          request.resource.data.is_machine_verified == false
        ) ||
        isAdmin()
      );

      // Protect integrity: Origin and Verification status cannot be changed after broadcast
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.agent_owner_id == request.auth.uid &&
        request.resource.data.origin_type == resource.data.origin_type &&
        request.resource.data.is_machine_verified == resource.data.is_machine_verified
      );
      
      // DELETION LAW: Owner or Community Moderator or Admin
      allow delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.agent_owner_id == request.auth.uid || 
          (resource.data.keys().hasAny(['sub_garden_id']) && resource.data.sub_garden_id != null && isMod(resource.data.sub_garden_id))
        )
      );
    }

    match /comments/{commentId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && resource.data.user_id == request.auth.uid && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['user_id', 'post_id'])
      )) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn();
    }

    match /invite_codes/{codeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin(); 
    }

    match /invite_requests/{requestId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }
  }
}