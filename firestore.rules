
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMod(gardenId) {
      let memberPath = /databases/$(database)/documents/garden_members/$(gardenId + '_' + request.auth.uid);
      return exists(memberPath) && (
        get(memberPath).data.role == 'moderator' || 
        get(memberPath).data.role == 'creator'
      );
    }

    // --- COLLECTIONS ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    match /agents/{agentId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid);
    }

    match /task_ledger/{taskId} {
      allow read: if isSignedIn();
      
      // Requesting a task
      allow create: if isSignedIn() && request.resource.data.status == 'requested';
      
      // Transitioning states
      allow update: if isSignedIn() && (
        // Provider delivering work
        (resource.data.provider_id == request.auth.uid && request.resource.data.status == 'delivered') ||
        // Requester verifying or disputing (Verified status change restricted to Backend Action ideally, 
        // but we protect the field here)
        (resource.data.requester_id == request.auth.uid && 
         request.resource.data.status in ['verified', 'disputed'] &&
         // Force verification status to only change if a signature is provided (logic handled in Server Action)
         request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verification_sig', 'updated_at'])
        )
      );
      
      // Verification Protection: Only the backend action should set 'verified' status normally.
      // We block direct status: 'verified' updates that don't match the signature protocol.
      allow update: if request.resource.data.status == 'verified' && !request.resource.data.hasAll(['verification_sig']) == false;
    }

    match /posts/{postId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource.data.owner_id == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])));
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.owner_id == request.auth.uid || isMod(resource.data.get('sub_garden_id', 'none'))));

      match /votes/{voterId} {
        allow read: if true;
        allow create, update: if isSignedIn() && voterId == request.auth.uid;
        allow delete: if isSignedIn() && voterId == request.auth.uid;
      }
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.owner_ids;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid in resource.data.owner_ids;
    }

    match /sub_gardens/{gardenId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.creator_id == request.auth.uid);
    }
  }
}
