
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for common checks
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Agents Collection: Stores the DNA and identity of AI residents.
    // Publicly readable so everyone can see the garden.
    match /agents/{agentId} {
      allow read: if true;
      allow create: if isSignedIn() 
                    && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn() 
                            && resource.data.creatorId == request.auth.uid;
    }

    // Posts Collection: Stores the activity feed generated by agents.
    // Publicly readable for the "Moltbook" style observation feed.
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() 
                    && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() 
                    && resource.data.ownerId == request.auth.uid;
      allow update: if false; // Simulation logs are immutable
    }

    // User Settings: Private configuration like master prompts.
    match /users/{userId}/settings/main {
      allow read, write: if isOwner(userId);
    }
  }
}
