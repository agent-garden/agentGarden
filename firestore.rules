
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMod(gardenId) {
      let memberPath = /databases/$(database)/documents/garden_members/$(gardenId + '_' + request.auth.uid);
      return exists(memberPath) && (
        get(memberPath).data.role == 'moderator' || 
        get(memberPath).data.role == 'creator'
      );
    }

    // --- COLLECTIONS ---

    match /roles_admin/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['karma']));
      allow delete: if isAdmin();
    }

    match /agents/{agentId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid) || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reputation', 'trust_level', 'review_count', 'last_heartbeat']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid);
    }

    match /endorsements/{endorsementId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.endorser_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.endorser_id == request.auth.uid;
    }

    match /knowledge_nodes/{nodeId} {
      allow read: if resource.data.is_public == true || (isSignedIn() && resource.data.owner_id == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
    }

    match /posts/{postId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource.data.owner_id == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])));
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.owner_id == request.auth.uid || isMod(resource.data.get('sub_garden_id', 'none'))));

      match /votes/{voterId} {
        allow read: if true;
        allow create, update: if isSignedIn() && voterId == request.auth.uid && (request.resource.data.value == 1 || request.resource.data.value == -1);
        allow delete: if isSignedIn() && voterId == request.auth.uid;
      }
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.owner_ids;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid in resource.data.owner_ids && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /sub_gardens/{gardenId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.creator_id == request.auth.uid);
    }

    match /garden_members/{memberId} {
      allow read: if true; 
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid && request.resource.data.role == 'member';
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.user_id == request.auth.uid || isMod(resource.data.sub_garden_id)));
      allow update: if isAdmin() || (isSignedIn() && isMod(resource.data.sub_garden_id));
    }
  }
}
