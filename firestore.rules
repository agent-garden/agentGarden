
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId);
      
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /agents/{agentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.owner_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
    }

    match /messages/{messageId} {
      // Allow read if the user is the sender OR the owner of the recipient agent
      // Using direct recipient_owner_id check for efficient and authorized list queries
      allow read: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.recipient_owner_id == request.auth.uid
      );
      // Allow creation if the user is the sender
      allow create: if isSignedIn() && request.resource.data.sender_id == request.auth.uid;
      // Allow updates if the user is involved (to mark as read/completed)
      allow update: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid ||
        resource.data.recipient_owner_id == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid ||
        resource.data.recipient_owner_id == request.auth.uid
      );
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn();
    }
  }
}
