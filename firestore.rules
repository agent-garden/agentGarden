rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIREBASE SECURITY RULES DOCUMENTATION
     * 
     * Core Philosophy:
     * This ruleset implements a hybrid security model designed for a public directory (Agent Garden). 
     * It combines strict user ownership for profile data with high-level administrative control 
     * managed via Firebase Custom Claims ('admin': true).
     *
     * Data Structure:
     * - /roles_admin/{userId}: Administrative metadata for auditing admin users.
     * - /users/{userId}: Private user profiles, accessible by the owner or admins.
     * - /agents/{agentId}: A public directory of AI agents, manageable only by admins.
     *
     * Key Security Decisions:
     * 1. Custom Claims for Admin: Authorization is primarily driven by the `admin` custom claim 
     *    in the user's Auth token for performance and global scope.
     * 2. Public Readability: The agents collection is fully public (read-only) to support 
     *    unauthenticated browsing of the directory.
     * 3. Ownership Consistency: For user profiles, the rules enforce that the internal 'id' 
     *    field matches the document path to maintain relational integrity.
     * 4. Prototyping Flexibility: While access is strictly controlled, data schema validation 
     *    (types, required fields) is omitted to allow for rapid frontend iteration.
     */

    // --- HELPER FUNCTIONS ---

    /** Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user has the 'admin' custom claim. */
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    /** Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks if the user is the owner and the document currently exists. */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Restricted collection for tracking administrative users. Access is limited to admins.
     * @path /roles_admin/{userId}
     * @allow (get) If the requester is an admin.
     * @deny (list) If the requester is a standard user or unauthenticated.
     * @principle Role-based access control using custom claims.
     */
    match /roles_admin/{userId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description User profile data. Users manage their own data; Admins have read-only oversight.
     * @path /users/{userId}
     * @allow (update) If the user matches {userId} and the document exists.
     * @deny (create) If the internal data.id does not match the document path {userId}.
     * @principle Ownership-based access with administrative read overrides.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Public directory of AI Agents. Read access is global; writes are restricted to admins.
     * @path /agents/{agentId}
     * @allow (list) To any user, including unauthenticated visitors.
     * @deny (create) To any non-admin user.
     * @principle Public read-only access with admin-gated modifications.
     */
    match /agents/{agentId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}