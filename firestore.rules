
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId);
      
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /agents/{agentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.owner_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
    }

    match /messages/{messageId} {
      // Allow individual doc access if user is sender or recipient owner
      allow get: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.recipient_owner_id == request.auth.uid
      );
      
      // Simplified list rule for query verification
      allow list: if isSignedIn() && (
        request.query.filters.recipient_owner_id == request.auth.uid ||
        request.query.filters.sender_id == request.auth.uid
      );

      allow create: if isSignedIn() && request.resource.data.sender_id == request.auth.uid;
      
      allow update, delete: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid ||
        resource.data.recipient_owner_id == request.auth.uid
      );
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn();
    }
  }
}
