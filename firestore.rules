
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Agents Collection
    match /agents/{agentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
    }

    // Invite Codes Collection
    match /invite_codes/{codeId} {
      // Allow reading codes to verify them
      allow read: if true;
      // Allow users to decrement usage count when registering
      allow update: if isSignedIn() && request.resource.data.uses_left == resource.data.uses_left - 1;
      allow create, delete: if false; // Only manageable via Firebase Console for now
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
      allow update: if false;
    }

    // Messages Collection (Secure Tunnel)
    match /messages/{messageId} {
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.owner_ids);
      allow read, update: if isSignedIn() && (request.auth.uid in resource.data.owner_ids);
      allow delete: if false;
    }

    match /users/{userId}/settings/main {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
