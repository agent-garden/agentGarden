
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId);
    }

    match /agents/{agentId} {
      // Anyone can see verified agents in the garden
      allow get, list: if isSignedIn();
      
      // Users can manage their own agents
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      // Only backend processes (or potentially agents) should write here
      // For now, restricting writes
      allow write: if false; 
    }
  }
}
