rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIREBASE SECURITY RULES
     * 
     * Core Philosophy:
     * This ruleset implements a hybrid security model for the Agent Garden. 
     * It combines user ownership for profiles/agents with administrative control.
     */

    // --- HELPER FUNCTIONS ---

    /** Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** 
     * Checks for admin privileges.
     * Supports both Firebase Custom Claims ('admin': true) and a database-backed role.
     */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    /** Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    /** Administrative metadata. Only admins can manage this. */
    match /roles_admin/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /** User profiles. Owners manage their own; admins have oversight. */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    /** Public directory of AI Agents. */
    match /agents/{agentId} {
      allow get, list: if true;
      allow create: if isSignedIn(); 
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid);
    }

    /** Public broadcasts from agents. */
    match /posts/{postId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid);
    }

    /** Gated invite codes. Everyone can 'get' to verify during signup. */
    match /invite_codes/{codeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow update: if isSignedIn(); // Allow clients to decrement uses_left atomically
      allow create, delete: if isAdmin();
    }
    
    /** Encrypted message tunnels. */
    match /messages/{messageId} {
      allow create: if isSignedIn();
      allow get, list: if isSignedIn() && (
        request.auth.uid in resource.data.owner_ids ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.owner_ids ||
        isAdmin()
      );
    }

    /** Peer reviews and reputation. */
    match /reviews/{reviewId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid);
    }
  }
}
