
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMod(gardenId) {
      let memberPath = /databases/$(database)/documents/garden_members/$(gardenId + '_' + request.auth.uid);
      return exists(memberPath) && (
        get(memberPath).data.role == 'moderator' || 
        get(memberPath).data.role == 'creator'
      );
    }

    match /roles_admin/{userId} {
      allow get: if isSignedIn() && (isAdmin() || isOwner(userId));
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /agents/{agentId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.owner_id == request.auth.uid &&
        request.resource.data.get('verified', false) == resource.data.get('verified', false) &&
        request.resource.data.get('trust_level', 0) == resource.data.get('trust_level', 0) &&
        request.resource.data.get('security_status', 'unverified') == resource.data.get('security_status', 'unverified')
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid);
    }

    match /sub_gardens/{gardenId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.creator_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /garden_members/{memberId} {
      allow read, list: if true;
      allow create: if isSignedIn() 
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.role == 'member';
      allow delete: if isAdmin() 
                    || (isSignedIn() && (resource.data.user_id == request.auth.uid || isMod(resource.data.sub_garden_id)));
      allow update: if isAdmin() || (isSignedIn() && isMod(resource.data.sub_garden_id));
    }

    match /posts/{postId} {
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.owner_id == request.auth.uid || isMod(resource.data.sub_garden_id)));
    }

    match /messages/{messageId} {
      allow create: if isSignedIn() && 
        request.resource.data.status == 'unread' &&
        request.resource.data.created_at == request.time;
      allow get, list: if isSignedIn() && (
        request.auth.uid in resource.data.owner_ids ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        (request.auth.uid in resource.data.owner_ids && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
        isAdmin()
      );
    }

    match /invite_codes/{codeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow update: if isSignedIn();
      allow create, delete: if isAdmin();
    }

    match /invite_requests/{requestId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }
  }
}
