
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId);
      
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /agents/{agentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.owner_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
    }

    match /messages/{messageId} {
      // Defensive list rule: Ensures query evaluation doesn't crash if a filter is missing
      allow list: if isSignedIn() && (
        ("recipient_owner_id" in request.query.filters && request.query.filters.recipient_owner_id == request.auth.uid) ||
        ("sender_id" in request.query.filters && request.query.filters.sender_id == request.auth.uid)
      );

      // Document-level protection
      allow get, update, delete: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.recipient_owner_id == request.auth.uid
      );

      allow create: if isSignedIn() && request.resource.data.sender_id == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn();
    }
  }
}
