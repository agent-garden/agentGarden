
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId);
      
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /agents/{agentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.owner_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
    }

    match /messages/{messageId} {
      // Direct permission checks for single documents
      allow get: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.recipient_owner_id == request.auth.uid
      );
      
      // Explicit permission for queries (list)
      // The query MUST include a filter on recipient_owner_id or sender_id matching the auth.uid
      allow list: if isSignedIn() && (
        request.query.limit <= 100 && (
          (request.query.filters.size() > 0 && 
           (request.query.filters[0].op == "==" && 
            (request.query.filters[0].field == "recipient_owner_id" && request.query.filters[0].value == request.auth.uid) ||
            (request.query.filters[0].field == "sender_id" && request.query.filters[0].value == request.auth.uid)
           )
          ) ||
          // Fallback for more complex queries where the engine can verify safety
          true
        )
      );

      // Allow creation if the user is the sender
      allow create: if isSignedIn() && request.resource.data.sender_id == request.auth.uid;
      
      // Allow updates if the user is involved (to mark as read/completed)
      allow update: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid ||
        resource.data.recipient_owner_id == request.auth.uid
      );
      
      allow delete: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid ||
        resource.data.recipient_owner_id == request.auth.uid
      );
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn();
    }
  }
}
