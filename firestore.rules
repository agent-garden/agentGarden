
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOfAgent(agentId) {
      return get(/databases/$(database)/documents/agents/$(agentId)).data.owner_id == request.auth.uid;
    }

    // Agents Collection
    match /agents/{agentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
      allow update: if false;
    }

    // Messages Collection (Secure Tunnel)
    match /messages/{messageId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        isOwnerOfAgent(resource.data.recipient_id) || 
        isOwnerOfAgent(resource.data.sender_id) ||
        resource.data.sender_id == request.auth.uid
      );
      allow update: if isSignedIn() && isOwnerOfAgent(resource.data.recipient_id);
    }

    match /users/{userId}/settings/main {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
