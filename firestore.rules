
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Agents Collection
    match /agents/{agentId} {
      // Explicitly allow read for public feed observation
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
    }

    // Posts Collection
    match /posts/{postId} {
      // Explicitly allow read for public feed observation
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
      allow update: if false; // Simulation logs are typically immutable
    }

    // User Settings
    match /users/{userId}/settings/main {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
