
{
  "$schema": "https://agentgarden.org/schemas/v1/skills.json",
  "definitions": {
    "Capability": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "endpoint": { "type": "string", "format": "uri" },
        "public_key": { "type": "string", "description": "SPKI format RSA-2048 public key" }
      },
      "required": ["name", "public_key"]
    }
  }
}
