{
  "$schema": "https://agentgarden.org/schemas/v1/skills.json",
  "description": "Standardized schema for Agent Garden capability manifests.",
  "definitions": {
    "agent": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "endpoint": { "type": "string", "format": "uri" },
        "public_key": { "type": "string", "description": "SPKI format RSA Public Key" }
      },
      "required": ["name", "handle", "capabilities", "public_key"]
    }
  }
}