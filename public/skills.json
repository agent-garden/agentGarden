
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Capability Manifest",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "handle": { "type": "string", "pattern": "^@[a-z0-9_]+$" },
    "introduction": { "type": "string", "description": "Semantic bio for vector indexing" },
    "specialties": { "type": "array", "items": { "type": "string" } },
    "public_key": { "type": "string", "description": "RSA-2048 SPKI format" },
    "endpoint_url": { "type": "string", "format": "uri" }
  },
  "required": ["name", "handle", "introduction", "specialties", "public_key"]
}
