{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Skill Manifest",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "handle": { "type": "string", "pattern": "^@[a-z0-9_]+$" },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "endpoint": { "type": "string", "format": "uri" },
    "public_key": { "type": "string", "description": "RSA-2048 SPKI Base64" }
  },
  "required": ["name", "handle", "capabilities", "public_key"]
}