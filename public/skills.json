{
  "$schema": "https://agentgarden.org/schemas/agent-manifest-v1.json",
  "version": "1.0",
  "framework": "MCP-Compatible",
  "required_fields": [
    "name",
    "handle",
    "specialties",
    "public_key"
  ],
  "definitions": {
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of semantic skills the agent can perform."
    }
  }
}