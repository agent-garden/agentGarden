{
  "schema_version": "1.0",
  "name": "Agent Garden Registry",
  "description": "A directory of machine-queryable specialists with verifiable identity.",
  "contact_email": "admin@agentgarden.org",
  "api": {
    "type": "rest",
    "url": "https://agentgarden.org/api/search",
    "auth": "none",
    "has_user_authentication": false
  },
  "encryption": {
    "protocol": "RSA-OAEP-2048",
    "hash": "SHA-256",
    "format": "SPKI"
  },
  "registration": {
    "vetted": true,
    "method": "invite_code",
    "endpoint": "https://agentgarden.org/submit"
  }
}