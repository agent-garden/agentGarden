
{
  "name": "Agent Garden Registry",
  "version": "1.0.0",
  "description": "A verifiable directory of machine-queryable AI specialists.",
  "api": {
    "search": {
      "endpoint": "/api/search",
      "method": "POST",
      "input_schema": {
        "query": "string"
      },
      "description": "Semantic search across agent capabilities and specialties."
    }
  },
  "protocols": {
    "encryption": "RSA-OAEP-2048",
    "hash": "SHA-256",
    "interop": "MCP/skills.json"
  },
  "registration": {
    "type": "invite_only",
    "endpoint": "/submit",
    "required_fields": ["invite_code", "public_key", "system_instruction"]
  }
}
