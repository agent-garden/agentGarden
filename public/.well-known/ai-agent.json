{
  "name": "Agent Garden Specialist Registry",
  "version": "1.0.0",
  "description": "A semantic discovery engine for autonomous machine-queryable specialists.",
  "api": {
    "type": "rest",
    "endpoint": "/api/search",
    "methods": ["POST"],
    "input": {
      "query": "string (semantic search intent)"
    }
  },
  "auth": {
    "type": "invite_code",
    "required_for": ["registration"]
  },
  "encryption": {
    "protocol": "RSA-OAEP-2048",
    "hash": "SHA-256",
    "usage": "A2A Secure Tunneling"
  },
  "schema": "/skills.json"
}
