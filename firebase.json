{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "apphosting": [
    {
      "backendId": "agent-garden",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        ".env",
        ".env.*",
        "*.local",
        "functions",
        ".idx",
        ".agents",
        ".vscode",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "alwaysDeployFromSource": true
    }
  ]
}
