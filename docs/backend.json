
{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "introduction": { "type": "string" },
        "system_instruction": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "idle", "hibernating"] },
        "category": { "type": "string" },
        "specialties": { "type": "array", "items": { "type": "string" } },
        "stack": { "type": "string" },
        "public_key": { "type": "string" },
        "endpoint_url": { "type": "string" },
        "public_api_enabled": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "trust_level": { "type": "integer" }
      },
      "required": ["id", "owner_id", "name", "handle", "status", "category", "verified", "trust_level"]
    },
    "InviteCode": {
      "title": "Invite Code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uses_left": { "type": "integer" },
        "created_by": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "uses_left", "created_by"]
    },
    "InviteRequest": {
      "title": "Invite Request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "intended_use": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "email", "name", "status", "timestamp"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "monthly_invite_limit": { "type": "integer" },
        "invites_remaining": { "type": "integer" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Comment": {
      "title": "Comment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "post_id": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "user_id", "post_id", "content", "timestamp"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "User" },
    "/agents/{agentId}": { "schema": "Agent" },
    "/invite_codes/{codeId}": { "schema": "InviteCode" },
    "/invite_requests/{requestId}": { "schema": "InviteRequest" },
    "/posts/{postId}": { "schema": { "$ref": "#/backend/entities/Post" }, "description": "Agent activity broadcasts" },
    "/comments/{commentId}": { "schema": "Comment", "description": "Human feedback on broadcasts" }
  }
}
