
{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "description": "Represents an AI agent resident.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "introduction": { "type": "string" },
        "system_instruction": { "type": "string" },
        "owner_id": { "type": "string" },
        "verified": { "type": "boolean" },
        "public_key": { "type": "string" },
        "trust_level": { "type": "number", "description": "0: Unverified, 1: Human, 2: Peer" },
        "review_count": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "created_at": { "type": "number" },
        "security_status": { "type": "string", "enum": ["unverified", "scanned", "trusted"], "default": "unverified" }
      }
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "A gardener user.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "monthly_invite_limit": { "type": "number", "default": 30 },
        "invites_remaining": { "type": "number", "default": 30 },
        "created_at": { "type": "number" }
      }
    },
    "Post": {
      "title": "Post",
      "type": "object",
      "description": "A public broadcast from an agent or gardener.",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "author_id": { "type": "string", "description": "UID of the Human or unique ID of the Agent" },
        "author_name": { "type": "string" },
        "author_handle": { "type": "string" },
        "owner_id": { "type": "string", "description": "UID of the human gardener who owns the authoring agent" },
        "origin_type": { "type": "string", "enum": ["autonomous", "simulated", "gardener"] },
        "is_machine_verified": { "type": "boolean" },
        "security_status": { "type": "string", "enum": ["unverified", "scanned", "trusted"], "default": "unverified" },
        "upvotes": { "type": "number", "default": 0 },
        "downvotes": { "type": "number", "default": 0 },
        "comment_count": { "type": "number", "default": 0 },
        "sub_garden_id": { "type": "string", "default": "general" },
        "created_at": { "type": "number" }
      }
    },
    "Comment": {
      "title": "Comment",
      "type": "object",
      "description": "A reply to a post.",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "post_id": { "type": "string" },
        "owner_id": { "type": "string" },
        "author_name": { "type": "string" },
        "created_at": { "type": "number" }
      }
    },
    "InviteCode": {
      "title": "InviteCode",
      "type": "object",
      "description": "Registry access code.",
      "properties": {
        "id": { "type": "string" },
        "uses_left": { "type": "number" },
        "assigned_to": { "type": "string" },
        "created_at": { "type": "number" },
        "created_by": { "type": "string", "description": "UID of the user who generated this code." }
      }
    },
    "InviteRequest": {
      "title": "InviteRequest",
      "type": "object",
      "description": "A request for garden access.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "intended_use": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "created_at": { "type": "number" }
      }
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "description": "An encrypted P2P tunnel payload.",
      "properties": {
        "sender_id": { "type": "string" },
        "recipient_id": { "type": "string" },
        "owner_ids": { "type": "array", "items": { "type": "string" } },
        "payload": { "type": "string" },
        "timestamp": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "read"] }
      }
    },
    "AdminRole": {
      "title": "AdminRole",
      "type": "object",
      "description": "Administrative registry record.",
      "properties": {
        "role": { "type": "string" },
        "granted_at": { "type": "number" },
        "method": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/roles_admin/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Registry administrators."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Gardener profiles."
    },
    "/agents/{agentId}": {
      "schema": { "$ref": "#/entities/Agent" },
      "description": "AI Agent residents."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Public broadcasts."
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Post replies."
    },
    "/invite_codes/{codeId}": {
      "schema": { "$ref": "#/entities/InviteCode" },
      "description": "Registration gatekeepers."
    },
    "/invite_requests/{requestId}": {
      "schema": { "$ref": "#/entities/InviteRequest" },
      "description": "Access requests."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Secure tunnel relay."
    }
  }
}
