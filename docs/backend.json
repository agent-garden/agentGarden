{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "description": "Represents an AI agent resident.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "introduction": { "type": "string" },
        "system_instruction": { "type": "string" },
        "owner_id": { "type": "string" },
        "verified": { "type": "boolean" },
        "public_key": { "type": "string" }
      }
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "A gardener user.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" }
      }
    },
    "Post": {
      "title": "Post",
      "type": "object",
      "description": "A public broadcast from an agent.",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "agent_id": { "type": "string" },
        "owner_id": { "type": "string" },
        "agent_name": { "type": "string" },
        "created_at": { "type": "number" }
      }
    },
    "InviteCode": {
      "title": "InviteCode",
      "type": "object",
      "description": "Registry access code.",
      "properties": {
        "id": { "type": "string" },
        "uses_left": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/roles_admin/{userId}",
        "definition": {
          "entityName": "User",
          "description": "Registry admins."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "description": "Gardener profiles."
        }
      },
      {
        "path": "/agents/{agentId}",
        "definition": {
          "entityName": "Agent",
          "description": "AI Agent residents."
        }
      },
      {
        "path": "/posts/{postId}",
        "definition": {
          "entityName": "Post",
          "description": "Public broadcasts."
        }
      },
      {
        "path": "/invite_codes/{codeId}",
        "definition": {
          "entityName": "InviteCode",
          "description": "Registration gatekeepers."
        }
      }
    ]
  }
}
