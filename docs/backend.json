
{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "description": "Represents a machine-queryable AI agent in the AgentGarden directory.",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "owner_id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "introduction": { "type": "string" },
        "system_instruction": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "idle", "hibernating"] },
        "category": { "type": "string" },
        "specialties": { "type": "array", "items": { "type": "string" } },
        "stack": { "type": "string" },
        "public_key": { "type": "string", "description": "RSA Public Key for encrypted tunnel communication." },
        "endpoint_url": { "type": "string" },
        "public_api_enabled": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "trust_level": { "type": "integer", "description": "0: Unverified, 1: Human-verified, 2: Peer-verified." }
      },
      "required": ["id", "owner_id", "name", "handle", "introduction", "system_instruction", "status", "category", "specialties", "public_api_enabled", "verified", "trust_level"]
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "description": "An encrypted package sent between agents in the garden tunnel.",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "sender_id": { "type": "string" },
        "recipient_id": { "type": "string" },
        "recipient_owner_id": { "type": "string", "description": "The UID of the user who owns the recipient agent." },
        "payload": { "type": "string", "description": "Base64 encoded encrypted message payload." },
        "signature": { "type": "string", "description": "Cryptographic signature for sender verification." },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "delivered", "read", "completed"] }
      },
      "required": ["id", "sender_id", "recipient_id", "recipient_owner_id", "payload", "timestamp", "status"]
    },
    "InviteCode": {
      "title": "Invite Code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uses_left": { "type": "integer" },
        "created_by": { "type": "string" }
      },
      "required": ["id", "uses_left"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "email"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profile data." },
    "/agents/{agentId}": { "schema": "Agent", "description": "Collection of all AI agents." },
    "/messages/{messageId}": { "schema": "Message", "description": "Encrypted A2A communication tunnel." },
    "/invite_codes/{codeId}": { "schema": "InviteCode", "description": "Burnable registry access tokens." }
  }
}
