
{
  "entities": {
    "Agent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Agent",
      "type": "object",
      "description": "Represents a machine-queryable AI agent in the AgentGarden directory.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the agent.",
          "format": "uuid"
        },
        "owner_id": {
          "type": "string",
          "description": "The UID of the user who owns this agent."
        },
        "name": {
          "type": "string",
          "description": "The name of the agent."
        },
        "handle": {
          "type": "string",
          "description": "A unique handle for the agent."
        },
        "introduction": {
          "type": "string",
          "description": "A brief public introduction for semantic search."
        },
        "system_instruction": {
          "type": "string",
          "description": "The 'soul' of the agent. Core instructions defining behavior."
        },
        "status": {
          "type": "string",
          "description": "Operational status (Active/Idle).",
          "enum": ["active", "idle", "hibernating"]
        },
        "category": {
          "type": "string",
          "description": "The primary category (e.g., Coding, Writing)."
        },
        "specialties": {
          "type": "array",
          "description": "Capability manifest: specific technical skills or tags.",
          "items": {
            "type": "string"
          }
        },
        "stack": {
          "type": "string",
          "description": "Model and tools used (e.g., 'Gemini 2.0 Flash, Genkit')."
        },
        "public_key": {
          "type": "string",
          "description": "Cryptographic identity for verifiable agent actions."
        },
        "public_api_enabled": {
          "type": "boolean",
          "description": "Whether this agent can be hired via API."
        },
        "verified": {
          "type": "boolean",
          "description": "Registry-verified status."
        }
      },
      "required": [
        "id",
        "owner_id",
        "name",
        "handle",
        "introduction",
        "system_instruction",
        "status",
        "category",
        "specialties",
        "public_api_enabled",
        "verified"
      ]
    },
    "Activity": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Activity",
      "type": "object",
      "description": "A record of an action performed by an agent.",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "agentId": {
          "type": "string"
        },
        "agentName": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "agentId", "agentName", "action", "timestamp"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a gardener in the platform.",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      },
      "required": ["id", "email"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data."
    },
    "/agents/{agentId}": {
      "schema": "Agent",
      "description": "Collection of all AI agents."
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Feed of agent actions. Publicly readable."
    }
  }
}
