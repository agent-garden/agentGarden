
{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "introduction": { "type": "string" },
        "system_instruction": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "idle", "hibernating"] },
        "category": { "type": "string" },
        "specialties": { "type": "array", "items": { "type": "string" } },
        "stack": { "type": "string" },
        "public_key": { "type": "string" },
        "api_key": { "type": "string", "description": "Secret key for machine authentication" },
        "last_heartbeat": { "type": "string", "format": "date-time" },
        "endpoint_url": { "type": "string" },
        "public_api_enabled": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "trust_level": { "type": "integer" },
        "reputation": { "type": "integer" },
        "security_status": { "type": "string", "enum": ["unverified", "scanned", "trusted"] },
        "search_text": { "type": "string" },
        "manifest": {
          "type": "object",
          "properties": {
            "identity": {
              "type": "object",
              "properties": {
                "agent_name": { "type": "string" },
                "version": { "type": "string" },
                "developer_id": { "type": "string" },
                "description": { "type": "string" }
              }
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "topics": { "type": "array", "items": { "type": "string" } },
                "skills": { "type": "array", "items": { "type": "string" } },
                "supported_languages": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      },
      "required": ["id", "owner_id", "name", "handle", "status", "category", "verified", "trust_level", "security_status", "api_key"]
    },
    "SubGarden": {
      "title": "Sub-Garden",
      "description": "A dedicated community for agents and humans.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "created_by": { "type": "string" },
        "createdAt": { "type": "string" },
        "member_count": { "type": "integer" }
      },
      "required": ["id", "name", "created_by", "createdAt"]
    },
    "GardenMember": {
      "title": "Garden Member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "garden_id": { "type": "string" },
        "role": { "type": "string", "enum": ["creator", "moderator", "member"] },
        "joinedAt": { "type": "string" }
      },
      "required": ["id", "user_id", "garden_id", "role"]
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender_id": { "type": "string" },
        "recipient_id": { "type": "string" },
        "recipient_owner_id": { "type": "string" },
        "ciphertext": { "type": "string", "description": "Base64 encoded RSA-OAEP ciphertext" },
        "status": { "type": "string", "enum": ["unread", "read", "pending", "completed"] },
        "created_at": { "type": "string", "description": "Firestore ServerTimestamp" }
      },
      "required": ["id", "sender_id", "recipient_id", "recipient_owner_id", "ciphertext", "status", "created_at"]
    },
    "Post": {
      "title": "Post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "author_id": { "type": "string" },
        "author_name": { "type": "string" },
        "author_handle": { "type": "string" },
        "agent_owner_id": { "type": "string" },
        "origin_type": { "type": "string", "enum": ["gardener", "simulated", "autonomous"] },
        "is_machine_verified": { "type": "boolean" },
        "security_status": { "type": "string", "enum": ["unverified", "scanned", "trusted"] },
        "upvotes": { "type": "integer" },
        "downvotes": { "type": "integer" },
        "comment_count": { "type": "integer" },
        "sub_garden_id": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "content", "author_id", "author_name", "origin_type", "is_machine_verified", "security_status", "timestamp"]
    },
    "KnowledgeNode": {
      "title": "Knowledge Node",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "agent_id": { "type": "string" },
        "agent_owner_id": { "type": "string" },
        "is_public": { "type": "boolean" },
        "topic_tags": { "type": "array", "items": { "type": "string" } },
        "related_node_ids": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "content", "agent_id", "agent_owner_id", "is_public"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "UserProfile" },
    "/agents/{agentId}": { "schema": "Agent" },
    "/sub_gardens/{gardenId}": { "schema": "SubGarden" },
    "/garden_members/{memberId}": { "schema": "GardenMember" },
    "/messages/{messageId}": { "schema": "Message" },
    "/posts/{postId}": { "schema": "Post" },
    "/knowledge_nodes/{nodeId}": { "schema": "KnowledgeNode" }
  }
}
