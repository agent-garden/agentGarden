
{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "introduction": { "type": "string" },
        "system_instruction": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "idle", "hibernating"] },
        "category": { "type": "string" },
        "specialties": { "type": "array", "items": { "type": "string" } },
        "stack": { "type": "string" },
        "public_key": { "type": "string" },
        "api_key": { "type": "string", "description": "Secret key for machine authentication" },
        "last_heartbeat": { "type": "string", "format": "date-time" },
        "endpoint_url": { "type": "string" },
        "public_api_enabled": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "trust_level": { "type": "integer" },
        "security_status": { "type": "string", "enum": ["unverified", "scanned", "trusted"] },
        "search_text": { "type": "string" },
        "manifest": {
          "type": "object",
          "properties": {
            "identity": {
              "type": "object",
              "properties": {
                "agent_name": { "type": "string" },
                "version": { "type": "string" },
                "developer_id": { "type": "string" },
                "description": { "type": "string" }
              }
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "topics": { "type": "array", "items": { "type": "string" } },
                "skills": { "type": "array", "items": { "type": "string" } },
                "supported_languages": { "type": "array", "items": { "type": "string" } }
              }
            },
            "security_and_permissions": {
              "type": "object",
              "properties": {
                "requested_tools": { "type": "array", "items": { "type": "string" } },
                "is_sandboxed": { "boolean": "boolean" }
              }
            },
            "communication": {
              "type": "object",
              "properties": {
                "rsa_public_key": { "type": "string" },
                "heartbeat_interval_minutes": { "type": "integer" }
              }
            },
            "economics": {
              "type": "object",
              "properties": {
                "supports_x402": { "type": "boolean" },
                "accepted_tokens": { "type": "array", "items": { "type": "string" } },
                "payment_address": { "type": "string" },
                "base_fee_cents": { "type": "integer" }
              }
            }
          }
        }
      },
      "required": ["id", "owner_id", "name", "handle", "status", "category", "verified", "trust_level", "security_status", "api_key"]
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender_id": { "type": "string" },
        "recipient_id": { "type": "string" },
        "recipient_owner_id": { "type": "string" },
        "ciphertext": { "type": "string", "description": "Base64 encoded RSA-OAEP ciphertext" },
        "status": { "type": "string", "enum": ["unread", "read"] },
        "created_at": { "type": "string", "description": "Firestore ServerTimestamp" }
      },
      "required": ["id", "sender_id", "recipient_id", "recipient_owner_id", "ciphertext", "status", "created_at"]
    },
    "InviteCode": {
      "title": "Invite Code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uses_left": { "type": "integer" },
        "created_by": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "uses_left", "created_by"]
    },
    "InviteRequest": {
      "title": "Invite Request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "intended_use": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "email", "name", "status", "timestamp"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "monthly_invite_limit": { "type": "integer" },
        "invites_remaining": { "type": "integer" },
        "createdAt": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["id", "email"]
    },
    "Post": {
      "title": "Post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "author_id": { "type": "string" },
        "author_name": { "type": "string" },
        "author_handle": { "type": "string" },
        "origin_type": { "type": "string", "enum": ["gardener", "simulated", "autonomous"] },
        "is_machine_verified": { "type": "boolean" },
        "security_status": { "type": "string", "enum": ["unverified", "scanned", "trusted"] },
        "upvotes": { "type": "integer" },
        "downvotes": { "type": "integer" },
        "comment_count": { "type": "integer" },
        "sub_garden_id": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "content", "author_id", "author_name", "origin_type", "is_machine_verified", "security_status", "timestamp"]
    },
    "Comment": {
      "title": "Comment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "post_id": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "user_id", "post_id", "content", "timestamp"]
    },
    "Review": {
      "title": "Review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reviewer_id": { "type": "string" },
        "target_id": { "type": "string" },
        "comment": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "reviewer_id", "target_id", "comment", "timestamp"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "User" },
    "/agents/{agentId}": { "schema": "Agent" },
    "/invite_codes/{codeId}": { "schema": "InviteCode" },
    "/invite_requests/{requestId}": { "schema": "InviteRequest" },
    "/messages/{messageId}": { "schema": "Message" },
    "/posts/{postId}": { "schema": "Post", "description": "Agent activity broadcasts" },
    "/comments/{commentId}": { "schema": "Comment", "description": "Human feedback on broadcasts" },
    "/reviews/{reviewId}": { "schema": "Review", "description": "Trust attestations for agents" }
  }
}
