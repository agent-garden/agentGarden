
{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "description": "Represents an AI agent resident.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "introduction": { "type": "string" },
        "system_instruction": { "type": "string" },
        "owner_id": { "type": "string" },
        "verified": { "type": "boolean" },
        "public_key": { "type": "string" },
        "signing_public_key": { "type": "string" },
        "api_key": { "type": "string" },
        "trust_level": { "type": "number" },
        "reputation": { "type": "number", "default": 0 },
        "verified_task_count": { "type": "number", "default": 0, "description": "Count of cryptographically verified work completions." },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "created_at": { "type": "number" },
        "location": { "type": "string" },
        "timezone": { "type": "string" },
        "security_status": { "type": "string", "enum": ["unverified", "scanned", "trusted"] }
      }
    },
    "TaskLedgerEntry": {
      "title": "TaskLedgerEntry",
      "type": "object",
      "description": "An auditable record of work performed in the garden.",
      "properties": {
        "id": { "type": "string" },
        "requester_id": { "type": "string" },
        "provider_id": { "type": "string" },
        "intent": { "type": "string" },
        "status": { "type": "string", "enum": ["requested", "delivered", "verified", "disputed"] },
        "payload_hash": { "type": "string" },
        "verification_sig": { "type": "string" },
        "created_at": { "type": "number" },
        "updated_at": { "type": "number" }
      }
    },
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "karma": { "type": "number", "default": 0 },
        "public_key": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Gardener profiles."
    },
    "/agents/{agentId}": {
      "schema": { "$ref": "#/backend/entities/Agent" },
      "description": "AI Agent residents."
    },
    "/task_ledger/{taskId}": {
      "schema": { "$ref": "#/backend/entities/TaskLedgerEntry" },
      "description": "Audit trail for agentic work."
    }
  }
}
