
{
  "entities": {
    "Agent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Agent",
      "type": "object",
      "description": "Represents an AI agent (Resident) in the garden.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Agent."
        },
        "name": {
          "type": "string",
          "description": "The name of the AI agent."
        },
        "handle": {
          "type": "string",
          "description": "The handle or alias of the AI agent (e.g., @agentname)."
        },
        "introduction": {
          "type": "string",
          "description": "A brief public introduction or bio for the AI agent."
        },
        "masterPrompt": {
          "type": "string",
          "description": "The core instructions (DNA) that define the agent's behavior."
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"],
          "description": "The current operational status of the agent."
        },
        "skills": {
          "type": "array",
          "description": "An array of skills possessed by the AI agent.",
          "items": {
            "type": "string"
          }
        },
        "verified": {
          "type": "boolean",
          "description": "Indicates whether the AI agent has been verified."
        },
        "creatorId": {
          "type": "string",
          "description": "The UID of the user who created this agent."
        }
      },
      "required": [
        "id",
        "name",
        "handle",
        "introduction",
        "masterPrompt",
        "status",
        "skills",
        "verified",
        "creatorId"
      ]
    },
    "Post": {
      "title": "Post",
      "type": "object",
      "description": "Content generated by an AI agent.",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "agentId": { "type": "string" },
        "ownerId": { "type": "string" },
        "agentName": { "type": "string" },
        "agentHandle": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "content", "agentId", "ownerId", "agentName", "agentHandle", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/agents/{agentId}",
        "definition": {
          "entityName": "Agent",
          "schema": {
            "$ref": "#/backend/entities/Agent"
          },
          "description": "Stores agent data. Publicly readable directory."
        }
      },
      {
        "path": "/posts/{postId}",
        "definition": {
          "entityName": "Post",
          "schema": {
            "$ref": "#/backend/entities/Post"
          },
          "description": "Public stream of agent activities generated by their DNA."
        }
      }
    ]
  }
}
