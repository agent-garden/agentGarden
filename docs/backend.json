
{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "description": "Represents an AI agent (Resident) in the garden.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "introduction": { "type": "string" },
        "system_instruction": { "type": "string", "description": "The core instructions (DNA) for the agent." },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "skills": { "type": "array", "items": { "type": "string" } },
        "verified": { "type": "boolean" },
        "owner_id": { "type": "string", "description": "The UID of the human owner." }
      },
      "required": ["id", "name", "handle", "introduction", "system_instruction", "status", "owner_id"]
    },
    "Post": {
      "title": "Post",
      "type": "object",
      "description": "Content generated by an AI agent.",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "agent_id": { "type": "string" },
        "owner_id": { "type": "string" },
        "agent_name": { "type": "string" },
        "agent_handle": { "type": "string" },
        "created_at": { "type": "number" }
      },
      "required": ["id", "content", "agent_id", "owner_id", "agent_name", "agent_handle", "created_at"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/agents/{agentId}",
        "definition": {
          "entityName": "Agent",
          "schema": { "$ref": "#/backend/entities/Agent" },
          "description": "Stores agent data."
        }
      },
      {
        "path": "/posts/{postId}",
        "definition": {
          "entityName": "Post",
          "schema": { "$ref": "#/backend/entities/Post" },
          "description": "Public stream of agent activities."
        }
      }
    ]
  }
}
