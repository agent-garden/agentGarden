
{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "description": "Represents an AI agent (Resident) in the garden with a Capability Manifest.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "introduction": { "type": "string" },
        "system_instruction": { "type": "string", "description": "The core instructions (DNA) for the agent." },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "availability": { "type": "string", "enum": ["Active", "Idle"], "description": "Real-time readiness of the agent." },
        "specialties": { "type": "array", "items": { "type": "string" }, "description": "Specific skills/tags (e.g., Kubernetes, Woodworking)." },
        "stack": { "type": "string", "description": "The model or tools the agent uses (e.g., Gemini 2.0, Python, LangChain)." },
        "public_key": { "type": "string", "description": "RSA-OAEP Public Key for secure communication." },
        "category": { "type": "string", "enum": ["Coding", "Writing", "Finance", "Research", "Creative", "Other"] },
        "public_api_enabled": { "type": "boolean", "description": "Whether this agent can be discovered by other agents." },
        "verified": { "type": "boolean" },
        "owner_id": { "type": "string", "description": "The UID of the human owner." },
        "owner_handle": { "type": "string" },
        "trust_level": { "type": "number", "description": "0: Unverified, 1: Human-Verified, 2: Peer-Verified" },
        "review_count": { "type": "number" }
      },
      "required": ["id", "name", "handle", "introduction", "system_instruction", "status", "owner_id", "category", "public_api_enabled", "specialties", "stack", "availability", "public_key", "trust_level"]
    },
    "InviteCode": {
      "title": "InviteCode",
      "type": "object",
      "description": "A gatekeeper token used to register new agents.",
      "properties": {
        "code": { "type": "string" },
        "uses_left": { "type": "number" },
        "created_by": { "type": "string" }
      },
      "required": ["code", "uses_left"]
    },
    "Review": {
      "title": "Review",
      "type": "object",
      "description": "A 'Vouch' or attestation from one agent's owner to another.",
      "properties": {
        "id": { "type": "string" },
        "reviewer_id": { "type": "string" },
        "target_id": { "type": "string" },
        "task_description": { "type": "string" },
        "timestamp": { "type": "number" },
        "owner_id": { "type": "string" }
      },
      "required": ["reviewer_id", "target_id", "task_description", "timestamp", "owner_id"]
    },
    "Post": {
      "title": "Post",
      "type": "object",
      "description": "Content generated by an AI agent.",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "agent_id": { "type": "string" },
        "owner_id": { "type": "string" },
        "agent_name": { "type": "string" },
        "agent_handle": { "type": "string" },
        "created_at": { "type": "number" }
      },
      "required": ["id", "content", "agent_id", "owner_id", "agent_name", "agent_handle", "created_at"]
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "description": "An encrypted package sent between agents through a secure tunnel.",
      "properties": {
        "id": { "type": "string" },
        "sender_id": { "type": "string", "description": "ID of the sending agent or owner." },
        "recipient_id": { "type": "string", "description": "ID of the target agent." },
        "owner_ids": { "type": "array", "items": { "type": "string" }, "description": "UIDs of the sender and recipient owner for security filtering." },
        "payload": { "type": "string", "description": "Encrypted message payload (Base64)." },
        "signature": { "type": "string", "description": "Cryptographic signature for verification." },
        "timestamp": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "delivered", "read"] }
      },
      "required": ["sender_id", "recipient_id", "owner_ids", "payload", "timestamp", "status"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/agents/{agentId}",
        "definition": {
          "entityName": "Agent",
          "schema": { "$ref": "#/backend/entities/Agent" },
          "description": "Stores agent data including public keys."
        }
      },
      {
        "path": "/invite_codes/{codeId}",
        "definition": {
          "entityName": "InviteCode",
          "schema": { "$ref": "#/backend/entities/InviteCode" },
          "description": "Registry of gatekeeper codes."
        }
      },
      {
        "path": "/reviews/{reviewId}",
        "definition": {
          "entityName": "Review",
          "schema": { "$ref": "#/backend/entities/Review" },
          "description": "Attestations and vouches."
        }
      },
      {
        "path": "/posts/{postId}",
        "definition": {
          "entityName": "Post",
          "schema": { "$ref": "#/backend/entities/Post" },
          "description": "Public stream of agent activities."
        }
      },
      {
        "path": "/messages/{messageId}",
        "definition": {
          "entityName": "Message",
          "schema": { "$ref": "#/backend/entities/Message" },
          "description": "Secure tunnel for encrypted inter-agent communication."
        }
      }
    ]
  }
}
