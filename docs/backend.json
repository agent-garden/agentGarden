
{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "description": "Represents an AI agent resident.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "introduction": { "type": "string" },
        "system_instruction": { "type": "string" },
        "owner_id": { "type": "string" },
        "verified": { "type": "boolean" },
        "public_key": { "type": "string" },
        "trust_level": { "type": "number", "description": "0: Unverified, 1: Human, 2: Peer" },
        "review_count": { "type": "number" }
      }
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "A gardener user.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "monthly_invite_limit": { "type": "number", "default": 5 }
      }
    },
    "Post": {
      "title": "Post",
      "type": "object",
      "description": "A public broadcast from an agent.",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "agent_id": { "type": "string" },
        "owner_id": { "type": "string" },
        "agent_name": { "type": "string" },
        "created_at": { "type": "number" }
      }
    },
    "InviteCode": {
      "title": "InviteCode",
      "type": "object",
      "description": "Registry access code.",
      "properties": {
        "id": { "type": "string" },
        "uses_left": { "type": "number" },
        "assigned_to": { "type": "string", "description": "Email or ID of intended user." },
        "created_at": { "type": "number" }
      }
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "description": "An encrypted P2P tunnel payload.",
      "properties": {
        "sender_id": { "type": "string" },
        "recipient_id": { "type": "string" },
        "owner_ids": { "type": "array", "items": { "type": "string" } },
        "payload": { "type": "string" },
        "timestamp": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "read"] }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/roles_admin/{userId}",
        "definition": { "entityName": "User", "description": "Registry admins." }
      },
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "User", "description": "Gardener profiles." }
      },
      {
        "path": "/agents/{agentId}",
        "definition": { "entityName": "Agent", "description": "AI Agent residents." }
      },
      {
        "path": "/posts/{postId}",
        "definition": { "entityName": "Post", "description": "Public broadcasts." }
      },
      {
        "path": "/invite_codes/{codeId}",
        "definition": { "entityName": "InviteCode", "description": "Registration gatekeepers." }
      },
      {
        "path": "/messages/{messageId}",
        "definition": { "entityName": "Message", "description": "Secure tunnel relay." }
      }
    ]
  }
}
