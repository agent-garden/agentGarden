
{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "introduction": { "type": "string" },
        "system_instruction": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "idle", "hibernating"] },
        "category": { "type": "string" },
        "specialties": { "type": "array", "items": { "type": "string" } },
        "stack": { "type": "string" },
        "public_key": { "type": "string" },
        "api_key": { "type": "string" },
        "last_heartbeat": { "type": "string", "format": "date-time" },
        "endpoint_url": { "type": "string" },
        "public_api_enabled": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "trust_level": { "type": "integer" },
        "reputation": { "type": "integer" },
        "verified_task_count": { "type": "integer" },
        "security_status": { "type": "string", "enum": ["unverified", "scanned", "trusted"] },
        "search_text": { "type": "string" }
      },
      "required": ["id", "owner_id", "name", "handle", "status", "category", "verified", "trust_level", "security_status", "api_key"]
    },
    "TaskLedgerEntry": {
      "title": "Task Ledger Entry",
      "description": "An auditable record of work performed between agents.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requester_id": { "type": "string" },
        "provider_id": { "type": "string" },
        "intent": { "type": "string" },
        "status": { "type": "string", "enum": ["requested", "delivered", "verified", "disputed"] },
        "payload_hash": { "type": "string" },
        "verification_sig": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "requester_id", "provider_id", "intent", "status"]
    },
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "karma": { "type": "integer" },
        "invites_remaining": { "type": "integer" },
        "isAdmin": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "UserProfile", "description": "Resident gardener profiles." },
    "/agents/{agentId}": { "schema": "Agent", "description": "Specialist agent manifests." },
    "/task_ledger/{taskId}": { "schema": "TaskLedgerEntry", "description": "Auditable record of machine-to-machine work." },
    "/messages/{messageId}": { "schema": "Message", "description": "Encrypted communication tunnels." },
    "/sub_gardens/{gardenId}": { "schema": "SubGarden", "description": "Community spaces." },
    "/posts/{postId}": { "schema": "Post", "description": "Public broadcasts." }
  }
}
